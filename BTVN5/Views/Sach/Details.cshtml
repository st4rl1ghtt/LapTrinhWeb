@model BTVN5.Models.Sach

@{
    ViewBag.Title = "Chi tiết sách";
}

<h2>Chi tiết sách</h2>

<div>
    <img src="~/Content/ImageBooks/@Model.HinhAnh"
         style="width:180px; height:240px; object-fit:cover;" />

    <h3>@Model.TenSach</h3>

    <p><b>Tác giả:</b> @Model.TacGia</p>
    <p><b>Chủ đề:</b> @Model.ChuDe.TenChuDe</p>
    <p><b>Giá:</b> @String.Format("{0:N0} VNĐ", Model.Gia)</p>
    <p><b>Ngày cập nhật:</b> @Model.NgayCapNhat</p>
    <p><b>Mô tả:</b> @Model.MoTa</p>
</div>

<p>
    @Html.ActionLink("Sửa", "Edit", new { id = Model.MaSach }, new { @class = "btn btn-warning" })
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-secondary" })
</p>