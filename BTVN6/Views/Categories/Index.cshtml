@model IEnumerable<BTVN6.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2 class="fw-bold text-primary">Categories</h2>
</div>

<div class="row row-cols-1 row-cols-md-4 g-4">
    @foreach (var category in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-4 text-center">
                <div class="card-body py-5">
                    <h4 class="card-title fw-bold text-dark mb-3">@category.Name</h4>
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id" class="btn btn-outline-primary rounded-pill px-4 mt-2">View Products</a>
                </div>
            </div>
        </div>
    }
</div>
