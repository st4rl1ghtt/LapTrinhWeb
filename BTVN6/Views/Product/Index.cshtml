@model IEnumerable<BTVN6.Models.Product>
@{
    ViewData["Title"] = "Product List";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2 class="fw-bold text-primary">All Products</h2>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model) {
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                @if (!string.IsNullOrEmpty(item.ImageUrl)) {
                    <img src="@item.ImageUrl" class="card-img-top rounded-top-4" alt="@item.Name" style="height: 200px; object-fit: cover;">
                } else {
                    <img src="https://picsum.photos/id/684/600/400" class="card-img-top rounded-top-4" alt="Placeholder" style="height: 200px; object-fit: cover;">
                }
                <div class="card-body">
                    <h5 class="card-title fw-bold">@item.Name</h5>
                    <p class="card-text text-muted text-truncate">@item.Description</p>
                    <h5 class="text-primary fw-bold">$@item.Price</h5>
                </div>
                <div class="card-footer bg-white border-0 pb-3 text-center">
                    <a asp-action="Display" asp-route-id="@item.Id" class="btn btn-outline-primary rounded-pill px-4">View Details</a>
                </div>
            </div>
        </div>
    }
</div>
