@model BTVN6.Models.Product
@{
    ViewData["Title"] = "Product Details";
}

<h2>Product Details</h2>

<div>
    <h4>Name: @Model.Name</h4>
    <h4>Price: @Model.Price</h4>
    <h4>Description: @Model.Description</h4>
    
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" alt="@Model.Name" style="max-width: 300px; display: block; margin-bottom: 10px;" />
    }

    @if (Model.ImageUrls != null && Model.ImageUrls.Any())
    {
        <div style="display: flex; gap: 10px; margin-top: 10px;">
            @foreach(var img in Model.ImageUrls)
            {
                <img src="@img" style="max-width: 150px; border: 1px solid #ccc;" />
            }
        </div>
    }
</div>

<div class="mt-3">
    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
