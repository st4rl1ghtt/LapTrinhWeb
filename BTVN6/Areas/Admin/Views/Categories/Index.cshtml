@model IEnumerable<BTVN6.Models.Category>
@{
    ViewData["Title"] = "Admin - Category List";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <h2 class="fw-bold text-primary">Manage Categories</h2>
    <a asp-action="Add" class="btn btn-primary rounded-pill px-4 shadow-sm">Create New Category</a>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Id</th>
                        <th>Name</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model) {
                        <tr>
                            <td class="ps-4 fw-medium text-muted">#@category.Id</td>
                            <td class="fw-bold">@category.Name</td>
                            <td class="text-end pe-4">
                                <a asp-action="Update" asp-route-id="@category.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3">Edit</a>
                                <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
