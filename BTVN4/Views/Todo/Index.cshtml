@model IEnumerable<BTVN4.Models.Todo>

@{
    ViewData["Title"] = "Index";
}

<div class="text-center border border-2 border-dark mb-4 p-3 shadow-sm rounded-1" style="background-color: #fcfcfc;">
    <div style="background-color: #cda8e4; padding: 10px; margin: -1rem -1rem 1rem -1rem;" class="border-bottom border-dark">
    </div>    
    <div class="text-start mt-4 px-3">
        <h2 class="text-secondary fw-normal">DANH SÁCH CÔNG VIỆC</h2>
        <p>
            <a asp-action="Create">Tạo mới công việc</a>
        </p>
        <table class="table table-borderless border-bottom">
            <thead class="border-bottom border-dark">
                <tr>
                    <th class="fw-bold">
                        Mã công việc
                    </th>
                    <th class="fw-bold">
                        Tên công việc
                    </th>
                    <th class="fw-bold">
                        Trạng thái hoàn thành
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
        @foreach (var item in Model) {
                <tr class="border-bottom">
                    <td>
                        @Html.DisplayFor(modelItem => item.Id)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Name)
                    </td>
                    <td>
                        <input type="checkbox" disabled="disabled" @(item.IsCompleted ? "checked" : "") />
                    </td>
                    <td class="text-end text-primary">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="text-decoration-none">Sửa</a> |
                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">Chi tiết</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id" class="text-decoration-none">Xoá</a>
                    </td>
                </tr>
        }
            </tbody>
        </table>
    </div>
</div>
