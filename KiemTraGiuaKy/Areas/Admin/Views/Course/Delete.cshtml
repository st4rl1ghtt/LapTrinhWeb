@model KiemTraGiuaKy.Models.Course
@{
    ViewData["Title"] = "Delete Course";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 border-danger">
            <div class="card-body p-5 text-center">
                <div class="mb-4">
                    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3.5rem;"></i>
                </div>
                <h1 class="h4 fw-bold text-dark mb-2">Delete Course?</h1>
                <p class="text-muted mb-4">This action cannot be undone. All enrollment records for this course will also be affected.</p>

                <div class="card bg-light border-0 rounded-3 p-3 mb-4 text-start">
                    <div class="d-flex align-items-start gap-3">
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <img src="@Model.Image" alt="@Model.Name" class="rounded-3 object-fit-cover flex-shrink-0" width="60" height="60" />
                        }
                        else
                        {
                            <div class="rounded-3 flex-shrink-0 d-flex align-items-center justify-content-center"
                                 style="width:60px; height:60px; background: linear-gradient(135deg, #667eea, #764ba2);">
                                <i class="bi bi-book-fill text-white"></i>
                            </div>
                        }
                        <div>
                            <h2 class="h6 fw-bold text-dark mb-1">@Model.Name</h2>
                            <p class="text-muted small mb-1"><i class="bi bi-person-fill me-1"></i>@Model.Lecturer</p>
                            <p class="text-muted small mb-1"><i class="bi bi-award-fill me-1"></i>@Model.Credits Credits</p>
                            <p class="text-muted small mb-0"><i class="bi bi-tag-fill me-1"></i>@(Model.Category?.Name ?? "N/A")</p>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold" id="deleteConfirmBtn">
                            <i class="bi bi-trash-fill me-1"></i>Yes, Delete
                        </button>
                    </form>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
