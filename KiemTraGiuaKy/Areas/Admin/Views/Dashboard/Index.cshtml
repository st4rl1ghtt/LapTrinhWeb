@using KiemTraGiuaKy.Areas.Admin.Controllers
@{
    ViewData["Title"] = "Admin Dashboard";
    var totalCourses = (int)(ViewData["TotalCourses"] ?? 0);
    var totalStudents = (int)(ViewData["TotalStudents"] ?? 0);
    var totalEnrollments = (int)(ViewData["TotalEnrollments"] ?? 0);

    var topCourses = ViewData["TopCourses"] as List<CourseStatItem> ?? new List<CourseStatItem>();
    var categoryStats = ViewData["CategoryStats"] as List<CategoryStatItem> ?? new List<CategoryStatItem>();
    var recentEnrollments = ViewData["RecentEnrollments"] as List<KiemTraGiuaKy.Models.Enrollment> ?? new List<KiemTraGiuaKy.Models.Enrollment>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Admin Dashboard
        </h1>
        <p class="text-muted mb-0">System overview and statistics</p>
    </div>
    <a asp-area="Admin" asp-controller="Course" asp-action="Create" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-plus-circle me-1"></i>Add New Course
    </a>
</div>

<!-- Stats Cards - Câu 10 -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
            <div class="card-body p-4 d-flex align-items-center gap-4">
                <div class="stat-icon rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:60px; height:60px; background: linear-gradient(135deg, #667eea, #764ba2);">
                    <i class="bi bi-collection-fill text-white fs-4"></i>
                </div>
                <div>
                    <p class="text-muted small mb-1 fw-medium text-uppercase letter-spacing">Total Courses</p>
                    <h2 class="fw-bold text-dark mb-0" style="font-size: 2rem;">@totalCourses</h2>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 px-4 pb-3">
                <a asp-area="Admin" asp-controller="Course" asp-action="Index" class="small text-primary fw-medium text-decoration-none">
                    View all courses <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
            <div class="card-body p-4 d-flex align-items-center gap-4">
                <div class="stat-icon rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:60px; height:60px; background: linear-gradient(135deg, #11998e, #38ef7d);">
                    <i class="bi bi-people-fill text-white fs-4"></i>
                </div>
                <div>
                    <p class="text-muted small mb-1 fw-medium text-uppercase letter-spacing">Total Students</p>
                    <h2 class="fw-bold text-dark mb-0" style="font-size: 2rem;">@totalStudents</h2>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 px-4 pb-3">
                <span class="small text-muted">Registered students</span>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
            <div class="card-body p-4 d-flex align-items-center gap-4">
                <div class="stat-icon rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:60px; height:60px; background: linear-gradient(135deg, #f7971e, #ffd200);">
                    <i class="bi bi-journal-check text-white fs-4"></i>
                </div>
                <div>
                    <p class="text-muted small mb-1 fw-medium text-uppercase letter-spacing">Total Enrollments</p>
                    <h2 class="fw-bold text-dark mb-0" style="font-size: 2rem;">@totalEnrollments</h2>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 px-4 pb-3">
                <span class="small text-muted">Course registrations</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Top Courses Table -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-transparent border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0"><i class="bi bi-trophy-fill text-warning me-2"></i>Top Popular Courses</h5>
            </div>
            <div class="card-body p-4">
                @if (topCourses.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr class="text-muted small text-uppercase">
                                    <th>#</th>
                                    <th>Course Name</th>
                                    <th class="text-end">Enrollments</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < topCourses.Count; i++)
                                {
                                    var item = topCourses[i];
                                    var rank = i + 1;
                                    var badgeClass = rank == 1 ? "bg-warning text-dark" : rank == 2 ? "bg-secondary text-white" : rank == 3 ? "bg-danger text-white" : "bg-light text-dark";
                                    <tr>
                                        <td>
                                            <span class="badge rounded-pill @badgeClass px-2">@rank</span>
                                        </td>
                                        <td class="fw-medium">@item.CourseName</td>
                                        <td class="text-end">
                                            <span class="badge bg-primary rounded-pill">@item.Count</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-3">No enrollments yet.</p>
                }
            </div>
        </div>
    </div>

    <!-- Category Distribution -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-transparent border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Courses by Category</h5>
            </div>
            <div class="card-body p-4">
                @{
                    var maxCount = categoryStats.Any() ? categoryStats.Max(c => c.Count) : 1;
                    string[] barColors = { "bg-primary", "bg-success", "bg-warning", "bg-danger", "bg-info" };
                }
                @if (categoryStats.Any())
                {
                    @for (int i = 0; i < categoryStats.Count; i++)
                    {
                        var cat = categoryStats[i];
                        var percentage = maxCount > 0 ? (cat.Count * 100 / maxCount) : 0;
                        var color = barColors[i % barColors.Length];
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-medium">@cat.CategoryName</span>
                                <span class="small text-muted">@cat.Count courses</span>
                            </div>
                            <div class="progress rounded-pill" style="height: 8px;">
                                <div class="progress-bar @color rounded-pill" style="width: @percentage%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center py-3">No categories found.</p>
                }
            </div>
        </div>
    </div>

    <!-- Recent Enrollments -->
    <div class="col-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-info me-2"></i>Recent Enrollments</h5>
            </div>
            <div class="card-body p-4">
                @if (recentEnrollments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr class="text-muted small text-uppercase">
                                    <th>Student</th>
                                    <th>Course</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var enrollment in recentEnrollments)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="avatar-circle bg-primary text-white" style="width:32px; height:32px; font-size:0.8rem;">
                                                    @((enrollment.User?.FullName ?? enrollment.User?.UserName ?? "U").Substring(0, 1).ToUpper())
                                                </span>
                                                <div>
                                                    <div class="fw-medium small">@(enrollment.User?.FullName ?? enrollment.User?.UserName)</div>
                                                    <div class="text-muted" style="font-size:0.75rem;">@enrollment.User?.Email</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-medium">@enrollment.Course?.Name</td>
                                        <td class="text-muted small">@enrollment.EnrollDate.ToString("MMM dd, yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-3">No recent enrollments.</p>
                }
            </div>
        </div>
    </div>
</div>
