@using Microsoft.AspNetCore.Identity
@using KiemTraGiuaKy.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle fw-medium d-flex align-items-center gap-1"
           href="#" id="userMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="avatar-circle bg-warning text-dark">
                @((user?.FullName ?? user?.UserName ?? "U").Substring(0, 1).ToUpper())
            </span>
            @(user?.FullName ?? user?.UserName)
        </a>
        <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-3" aria-labelledby="userMenuLink">
            @if (User.IsInRole("Admin"))
            {
                <li>
                    <a class="dropdown-item fw-semibold text-primary" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-area="Admin" asp-controller="Course" asp-action="Index">
                        <i class="bi bi-collection-fill me-2"></i>Manage Courses
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
            }
            @if (User.IsInRole("Student"))
            {
                <li>
                    <a class="dropdown-item" asp-controller="Enroll" asp-action="MyCourses">
                        <i class="bi bi-journal-bookmark-fill me-2"></i>My Courses
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
            }
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link fw-medium" asp-controller="Account" asp-action="Register">
            <i class="bi bi-person-plus-fill me-1"></i>Register
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-warning btn-sm fw-semibold rounded-pill px-3 ms-2 my-auto" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>Login
        </a>
    </li>
}
</ul>
