@model KiemTraGiuaKy.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
    <h1 class="display-4 fw-bold text-danger mt-3">An Error Occurred</h1>
    <p class="lead text-muted">Sorry, something went wrong. Please try again later.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
    <a asp-action="Index" class="btn btn-primary rounded-pill px-4 mt-3">
        <i class="bi bi-house-fill me-2"></i>Go Home
    </a>
</div>
