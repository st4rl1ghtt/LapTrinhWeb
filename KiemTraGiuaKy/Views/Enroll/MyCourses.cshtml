@model IEnumerable<KiemTraGiuaKy.Models.Enrollment>
@{
    ViewData["Title"] = "My Courses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-journal-bookmark-fill text-primary me-2"></i>My Courses
        </h1>
        <p class="text-muted mb-0">Courses you are currently enrolled in</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-plus-circle me-1"></i>Browse More Courses
    </a>
</div>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var enrollment in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                    <!-- Course Image -->
                    <div class="position-relative" style="height: 180px; overflow: hidden;">
                        @if (!string.IsNullOrEmpty(enrollment.Course?.Image))
                        {
                            <img src="@enrollment.Course.Image" alt="@enrollment.Course.Name"
                                 class="w-100 h-100 object-fit-cover" />
                        }
                        else
                        {
                            <div class="w-100 h-100 d-flex align-items-center justify-content-center"
                                 style="background: linear-gradient(135deg, #11998e, #38ef7d);">
                                <i class="bi bi-book-fill text-white" style="font-size: 3rem; opacity: 0.8;"></i>
                            </div>
                        }
                        <span class="position-absolute top-0 start-0 m-2 badge bg-success rounded-pill">
                            <i class="bi bi-check-circle-fill me-1"></i>Enrolled
                        </span>
                    </div>

                    <div class="card-body d-flex flex-column p-4">
                        <h2 class="card-title h6 fw-bold text-dark mb-2">@enrollment.Course?.Name</h2>

                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="bi bi-person-fill text-muted small"></i>
                            <span class="text-muted small">@enrollment.Course?.Lecturer</span>
                        </div>

                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-tag-fill text-muted small"></i>
                            <span class="text-muted small">@(enrollment.Course?.Category?.Name ?? "General")</span>
                        </div>

                        <div class="d-flex gap-2 mb-3">
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2 py-1 small">
                                <i class="bi bi-award-fill me-1"></i>@enrollment.Course?.Credits Credits
                            </span>
                        </div>

                        <p class="text-muted small mb-0 mt-auto">
                            <i class="bi bi-calendar3 me-1"></i>
                            Enrolled: @enrollment.EnrollDate.ToString("MMM dd, yyyy")
                        </p>
                    </div>

                    <div class="card-footer bg-transparent border-top-0 px-4 pb-4">
                        <form asp-controller="Enroll" asp-action="Unenroll" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="enrollmentId" value="@enrollment.Id" />
                            <input type="hidden" name="returnUrl" value="/Enroll/MyCourses" />
                            <button type="submit" class="btn btn-outline-danger w-100 rounded-pill btn-sm fw-semibold"
                                    onclick="return confirm('Are you sure you want to unenroll from this course?')">
                                <i class="bi bi-x-circle me-1"></i>Unenroll
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-4 text-muted small">
        You are enrolled in <strong>@Model.Count()</strong> course(s).
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-journal-x text-muted" style="font-size: 4rem;"></i>
        <h3 class="text-muted mt-3">No courses yet</h3>
        <p class="text-muted">You haven't enrolled in any courses. Start exploring!</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-5 py-2 mt-2">
            <i class="bi bi-search me-2"></i>Browse Courses
        </a>
    </div>
}
