@model KiemTraGiuaKy.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 shadow-lg rounded-4 mt-4">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="bi bi-box-arrow-in-right text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h1 class="h3 fw-bold text-dark">Welcome Back</h1>
                    <p class="text-muted small">Sign in to your CourseApp account</p>
                </div>

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control rounded-3 border-light-subtle"
                               placeholder="name@example.com" id="loginEmail" />
                        <label asp-for="Email" class="text-muted">
                            <i class="bi bi-envelope-fill me-1"></i>Email
                        </label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control rounded-3 border-light-subtle"
                               placeholder="Password" id="loginPassword" />
                        <label asp-for="Password" class="text-muted">
                            <i class="bi bi-lock-fill me-1"></i>Password
                        </label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" id="loginRememberMe" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small">
                            Remember me on this device
                        </label>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-semibold shadow-sm" id="loginSubmit">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </button>
                    </div>

                    <div class="text-center text-muted small">
                        Don't have an account?
                        <a asp-action="Register" class="text-primary fw-semibold text-decoration-none">Create one</a>
                    </div>

                    <div class="d-flex align-items-center my-3">
                        <hr class="flex-grow-1" />
                        <span class="mx-2 text-muted small">or</span>
                        <hr class="flex-grow-1" />
                    </div>

                    <!-- Google Login (Câu 9) -->
                    <div class="d-grid">
                        <a asp-controller="Account" asp-action="ExternalLogin"
                           asp-route-provider="Google"
                           asp-route-returnUrl="@ViewData["ReturnUrl"]"
                           class="btn btn-outline-secondary rounded-pill fw-medium d-flex align-items-center justify-content-center gap-2" id="googleLoginLink">
                            <img src="https://www.google.com/favicon.ico" width="18" height="18" alt="Google" />
                            Continue with Google
                        </a>
                    </div>
                </form>

                <!-- Demo credentials hint -->
                <div class="mt-4 p-3 bg-light rounded-3 small">
                    <p class="fw-semibold text-dark mb-1"><i class="bi bi-info-circle me-1"></i>Demo Accounts:</p>
                    <p class="mb-0 text-muted">Admin: <code>admin@courseapp.com</code> / <code>Admin@123</code></p>
                    <p class="mb-0 text-muted">Student: <code>student@courseapp.com</code> / <code>Student@123</code></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
