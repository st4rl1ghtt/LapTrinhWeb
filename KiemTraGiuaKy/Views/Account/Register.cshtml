@model KiemTraGiuaKy.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-lg rounded-4 mt-4">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="mb-3">
                        <i class="bi bi-person-plus-fill text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h1 class="h3 fw-bold text-dark">Create Account</h1>
                    <p class="text-muted small">Join CourseApp and start learning today</p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="UserName" class="form-control rounded-3 border-light-subtle"
                               placeholder="username" id="registerUsername" />
                        <label asp-for="UserName" class="text-muted">
                            <i class="bi bi-person-fill me-1"></i>Username
                        </label>
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control rounded-3 border-light-subtle"
                               placeholder="name@example.com" id="registerEmail" />
                        <label asp-for="Email" class="text-muted">
                            <i class="bi bi-envelope-fill me-1"></i>Email
                        </label>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="FullName" class="form-control rounded-3 border-light-subtle"
                               placeholder="Full Name" id="registerFullName" />
                        <label asp-for="FullName" class="text-muted">
                            <i class="bi bi-card-text me-1"></i>Full Name
                        </label>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Password" class="form-control rounded-3 border-light-subtle"
                               placeholder="Password" id="registerPassword" />
                        <label asp-for="Password" class="text-muted">
                            <i class="bi bi-lock-fill me-1"></i>Password
                        </label>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="ConfirmPassword" class="form-control rounded-3 border-light-subtle"
                               placeholder="Confirm Password" id="registerConfirmPassword" />
                        <label asp-for="ConfirmPassword" class="text-muted">
                            <i class="bi bi-lock-fill me-1"></i>Confirm Password
                        </label>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-semibold shadow-sm" id="registerSubmit">
                            <i class="bi bi-person-plus me-2"></i>Create Account
                        </button>
                    </div>

                    <div class="text-center text-muted small">
                        Already have an account?
                        <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">Sign in</a>
                    </div>

                    <div class="d-flex align-items-center my-3">
                        <hr class="flex-grow-1" />
                        <span class="mx-2 text-muted small">or</span>
                        <hr class="flex-grow-1" />
                    </div>

                    <!-- Google Login -->
                    <div class="d-grid">
                        <a asp-controller="Account" asp-action="ExternalLogin"
                           asp-route-provider="Google"
                           asp-route-returnUrl="@ViewData["ReturnUrl"]"
                           class="btn btn-outline-secondary rounded-pill fw-medium d-flex align-items-center justify-content-center gap-2" id="googleLoginBtn">
                            <img src="https://www.google.com/favicon.ico" width="18" height="18" alt="Google" />
                            Continue with Google
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
